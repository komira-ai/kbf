#!/usr/bin/env bash
# A fake of each macOS program the XCUITest sandbox probe and lib.sh run, for the
# Linux selftest (run.sh). run.sh links it into the test's bin directory under each
# program's name. Its state is files under $FAKE_STATE, which the tests set; every
# call is logged to $FAKE_STATE/log.

set -u
S=$FAKE_STATE
NAME=${0##*/}
CALLER_PATH=$PATH
PATH=$FAKE_REAL_PATH
printf '%s %s\n' "$NAME" "$*" >>"$S/log"
has() { [ -e "$S/$1" ]; }

case "$NAME" in
    uname) echo arm64 ;;
    sw_vers)
        case "$1" in
            -productVersion) echo 26.0 ;;
            -buildVersion) echo 25A100 ;;
        esac
        ;;
    xcodebuild) printf 'Xcode 26.0\nBuild version 17A100\n' ;;
    launchctl) [ "$1" = managername ] && echo Aqua ;;
    # stat -f %Su /dev/console: the console user.
    stat) echo runner ;;
    id)
        case "${1-}" in
            -u) echo 501 ;;
            -Gn) echo 'staff admin' ;;
        esac
        ;;
    sandbox-exec)
        # sandbox-exec [-D PARAM] -p PROFILE CMD...: under `(deny default)` the exec is
        # reported as the real sandbox reports a deny (to $S/sandbox.log, which the fake
        # `log show` prints) unless the test says it goes unreported, and refused unless
        # the test says the deny is ignored. The driver's profile (it denies lsopen) is
        # kept in $S/driver_profile.<n> and CMD runs with FAKE_SANDBOX=driver, which the
        # fake run.sh reads.
        if [ "$1" = -D ]; then
            printf '%s\n' "$2" >>"$S/sandbox_params"
            shift 2
        fi
        profile=$2
        shift 2
        case "$profile" in
            *"(deny default)"*)
                has deny_default_unreported ||
                    printf '2026-10-11 12:00:00.000 E  kernel[0:1] (Sandbox) Sandbox: sandbox-exec(%s) deny(1) process-exec* %s\n' \
                        "$$" "$1" >>"$S/sandbox.log"
                if ! has deny_default_ignored; then
                    echo "sandbox-exec: execvp() of '$1' failed: Operation not permitted" >&2
                    exit 71
                fi
                ;;
            *"(deny lsopen)"*)
                n=$(find "$S" -name 'driver_profile.*' | wc -l | tr -d ' ')
                printf '%s' "$profile" >"$S/driver_profile.$n"
                export FAKE_SANDBOX=driver
                ;;
        esac
        PATH=$CALLER_PATH exec "$@"
        ;;
    log)
        # log show ... --predicate 'sender == "Sandbox"': every report the fakes wrote.
        [ "$1" = show ] || exit 64
        cat "$S/sandbox.log" 2>/dev/null
        ;;
    *)
        echo "fakecmd: no fake for $NAME" >&2
        exit 127
        ;;
esac
