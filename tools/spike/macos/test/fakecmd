#!/usr/bin/env bash
# A fake of each macOS program the macOS probes run, for the Linux selftest (run.sh).
# run.sh links it into $FAKE_BIN under each program's name. Its state is files under
# $FAKE_STATE, which the tests set; every call is logged to $FAKE_STATE/log. Output
# formats follow what the probes parse; the automationmodetool wording is the one
# hosted macOS 26 and 15 runners printed (docs/spikes/macos-p0.md).

set -u
S=$FAKE_STATE
NAME=${0##*/}
CALLER_PATH=$PATH
PATH=$FAKE_REAL_PATH
printf '%s %s\n' "$NAME" "$*" >>"$S/log"
has() { [ -e "$S/$1" ]; }

case "$NAME" in
    uname) echo arm64 ;;
    sw_vers)
        case "$1" in
            -productVersion) echo 26.0 ;;
            -buildVersion) echo 25A100 ;;
        esac
        ;;
    xcodebuild) printf 'Xcode 26.0\nBuild version 17A100\n' ;;
    launchctl) [ "$1" = managername ] && echo Aqua ;;
    stat)
        # stat -f %Su /dev/console: the console user. stat -f %u:%g FILE: the caller
        # when the test says the mount at FILE's directory shows its reader as every
        # owner (shows_caller_<mount>, what macOS does on a noowners volume), else the
        # owner this mount shows (FILE.view, a chown a mount took but did not store),
        # else the stored one (FILE.owner, from cp and chown).
        if [ "$2" = %Su ]; then
            echo runner
        elif has "shows_caller_$(basename "$(dirname "$3")")"; then
            if [ "${FAKE_UID:-501}" = 0 ]; then echo 0:0; else echo "${FAKE_UID:-501}:20"; fi
        elif [ -e "$3.view" ]; then
            cat "$3.view"
        elif [ -e "$3.owner" ]; then
            cat "$3.owner"
        else
            echo "stat: $3: stat: No such file or directory" >&2
            exit 1
        fi
        ;;
    cp)
        "$NAME" "$@" || exit
        if [ "${FAKE_UID:-501}" = 0 ]; then echo 0:0 >"$2.owner"; else echo "${FAKE_UID:-501}:20" >"$2.owner"; fi
        ;;
    chown)
        # chown OWNER FILE. Root stores OWNER (or 99:99 when the test says the volume
        # loses root owners). Another user gets EPERM, unless the test says the volume
        # lets it store OWNER, stores only OWNER's group (chown_group_only), or takes
        # the chown without storing it (chown_lies).
        if [ "${FAKE_UID:-501}" = 0 ]; then
            if has root_owner_lost; then echo 99:99 >"$2.owner"; else echo "$1" >"$2.owner"; fi
        elif has owners_writable; then
            echo "$1" >"$2.owner"
        elif has chown_group_only; then
            # The group is stored, the owner stays the caller's.
            echo "${FAKE_UID:-501}:${1#*:}" >"$2.owner"
        elif has chown_lies; then
            echo "$1" >"$2.view"
        else
            echo "chown: $2: Operation not permitted" >&2
            exit 1
        fi
        ;;
    hdiutil)
        # A disk image IMG is the directory IMG.store; an attach links the mount point
        # to it, a detach drops the link and the views a chown left (chown_lies).
        verb=$1
        shift
        case "$verb" in
            create)
                for img; do :; done
                if has create_fails; then
                    echo 'hdiutil: create failed - Operation not permitted' >&2
                    exit 1
                fi
                # recreate_user: while the root control runs, someone deletes the
                # probe's user and makes the name again, with uid 503.
                if [ "${FAKE_UID:-501}" = 0 ] && has recreate_user; then
                    for u in "$S"/user_*; do [ -e "$u" ] && echo 503 >"$u"; done
                fi
                mkdir -p "$img.store"
                : >"$img"
                echo "created: $img"
                ;;
            attach)
                mnt='' ro=''
                while [ $# -gt 1 ]; do
                    if [ "$1" = -mountpoint ]; then mnt=$2; fi
                    if [ "$1" = -readonly ]; then ro=" read-only,"; fi
                    shift
                done
                img=$1
                if [ "${FAKE_UID:-501}" != 0 ] && has attach_fails; then
                    echo 'hdiutil: attach failed - Device not configured' >&2
                    exit 1
                fi
                [ -d "$img.store" ] || exit 1
                rmdir "$mnt" && ln -s "$img.store" "$mnt"
                # The flags hosted runners printed; "mounted by" only for a user's attach;
                # noowners when the test says this mount point ignores owners
                # (noowners_<mount>); no line at all for unlisted_<mount>.
                if [ "${FAKE_UID:-501}" = 0 ]; then by=; else by=", mounted by ${FAKE_AS:-runner}"; fi
                no=''
                has "noowners_${mnt##*/}" && no=' noowners,'
                has "unlisted_${mnt##*/}" ||
                    echo "/dev/disk4s1 on $mnt (apfs, local, nodev, nosuid,$ro journaled,$no nobrowse$by)" >>"$S/mounts"
                printf '/dev/disk4s1\t41504653-0000-11AA-AA11-00306543ECAC\t%s\n' "$mnt"
                ;;
            detach)
                force=''
                if [ "$1" = -force ]; then
                    force=1
                    shift
                fi
                # busy_<mount>: a detach without -force fails, as when a process
                # holds a file on the volume open.
                if [ -z "$force" ] && has "busy_${1##*/}"; then
                    echo "hdiutil: couldn't unmount \"disk4\" - Resource busy" >&2
                    exit 16
                fi
                [ -L "$1" ] || exit 1
                store=$(readlink "$1")
                rm -f "$store"/*.view "$1"
                grep -vF " on $1 " "$S/mounts" >"$S/mounts.new" || true
                mv "$S/mounts.new" "$S/mounts"
                echo '"disk4" ejected.'
                ;;
        esac
        ;;
    csrutil) echo 'System Integrity Protection status: disabled.' ;;
    pgrep) cat "$S/launchd_sim" 2>/dev/null ;;
    id)
        case "${1-}" in
            -u)
                # id -u: the caller's uid. id -u NAME: NAME's uid (the user file's
                # content, 502 when the test planted it empty), or status 1.
                if [ -n "${2-}" ]; then
                    has "user_$2" || exit 1
                    u=$(cat "$S/user_$2")
                    echo "${u:-502}"
                else
                    echo "${FAKE_UID:-501}"
                fi
                ;;
            -un) echo "${FAKE_AS:-runner}" ;;
            -Gn)
                # A user made by the probe is standard unless the test says otherwise.
                if [ -n "${FAKE_AS-}" ] && ! has probe_user_admin; then echo 'staff everyone localaccounts'; else echo 'staff admin'; fi
                ;;
            *) has "user_$1" ;;
        esac
        ;;
    sudo)
        # sudo -n [-u USER] CMD...: runs CMD as root (or USER) in the fake.
        [ "$1" = -n ] && shift
        [ "$1" = -H ] && shift
        if [ "$1" = -u ]; then
            has "user_$2" || {
                echo "sudo: unknown user $2" >&2
                exit 1
            }
            export FAKE_UID=502 FAKE_AS="$2"
            shift 2
        else
            export FAKE_UID=0
        fi
        PATH=$CALLER_PATH exec "$@"
        ;;
    automationmodetool)
        auth=$(cat "$S/auth")
        case "${1-}" in
            "")
                if [ "$auth" = weird ]; then
                    echo 'Something else entirely.'
                    exit 0
                fi
                echo 'Automation Mode is disabled.'
                if [ "$auth" = not_required ]; then
                    echo 'This device DOES NOT REQUIRE user authentication to enable Automation Mode.'
                else
                    echo 'This device requires user authentication to enable Automation Mode.'
                fi
                ;;
            enable-automationmode-without-authentication)
                [ "${FAKE_UID:-501}" = 0 ] || exit 1
                has hang_enable && sleep 30
                echo not_required >"$S/auth"
                ;;
            disable-automationmode-without-authentication)
                [ "${FAKE_UID:-501}" = 0 ] || exit 1
                has disable_noop || echo required >"$S/auth"
                ;;
        esac
        ;;
    sysadminctl)
        [ "${FAKE_UID:-501}" = 0 ] || exit 1
        case "$1" in
            -addUser)
                has hang_adduser && sleep 30
                echo 502 >"$S/user_$2"
                ;;
            -deleteUser)
                rm -f "$S/user_$2"
                if has delete_resets; then echo required >"$S/auth"; fi
                ;;
        esac
        ;;
    mount) cat "$S/mounts" 2>/dev/null ;;
    sandbox-exec)
        # sandbox-exec -p PROFILE CMD...: a profile naming CoreSimulatorService blocks the
        # fake simctl, unless the test says the deny is ignored.
        profile=$2
        shift 2
        case "$profile" in
            *CoreSimulatorService*) has deny_ignored || export FAKE_SIM_DENIED=1 ;;
            *)
                if has allow_fails; then
                    echo 'sandbox-exec: sandbox_apply: Operation not permitted' >&2
                    exit 71
                fi
                ;;
        esac
        PATH=$CALLER_PATH exec "$@"
        ;;
    xcrun)
        [ "$1" = simctl ] || exit 1
        shift
        set_dir=
        if [ "$1" = --set ]; then
            set_dir=$2
            shift 2
        fi
        if [ -n "${FAKE_SIM_DENIED-}" ]; then
            echo 'Unable to locate CoreSimulatorService' >&2
            exit 163
        fi
        verb=$1
        shift
        case "$verb" in
            list)
                case "$1" in
                    runtimes)
                        echo '== Runtimes =='
                        echo 'iOS 18.6 (18.6 - 22G86) - com.apple.CoreSimulator.SimRuntime.iOS-18-6'
                        echo 'iOS 26.0 (26.0 - 23A339) - com.apple.CoreSimulator.SimRuntime.iOS-26-0'
                        echo 'iOS 26.1 (26.1 - 23B1) - com.apple.CoreSimulator.SimRuntime.iOS-26-1 (unavailable, runtime missing)'
                        ;;
                    devicetypes)
                        echo '== Device Types =='
                        echo 'iPad Air 11-inch (M3) (com.apple.CoreSimulator.SimDeviceType.iPad-Air-11-inch-M3)'
                        echo 'iPhone 17 Pro (com.apple.CoreSimulator.SimDeviceType.iPhone-17-Pro)'
                        ;;
                esac
                ;;
            create)
                printf '%s %s\n' "$2" "$3" >"$S/created"
                if has create_garbage; then
                    # Error text with status 0: only the UDID check can catch it.
                    echo 'An error was encountered processing the command (code=161).' >&2
                    exit 0
                fi
                mkdir -p "$set_dir/0A1B2C3D-0000-4000-8000-000000000001"
                echo 0A1B2C3D-0000-4000-8000-000000000001
                ;;
            boot) : >"$S/booted" ;;
            bootstatus)
                has booted || exit 1
                if has bootstatus_fails; then exit 1; fi
                ;;
            io)
                has booted || exit 1
                if has bad_png; then echo 'not a png' >"$3"; else printf '\211PNG\r\n\032\nrest' >"$3"; fi
                ;;
            shutdown) rm -f "$S/booted" ;;
            delete)
                if has delete_fails; then
                    echo 'Unable to delete device: busy' >&2
                    exit 149
                fi
                rm -rf "${set_dir:?}/$1"
                ;;
        esac
        ;;
    sqlite3)
        # sqlite3 DB "CREATE ...; INSERT ... VALUES ('a', 'b', 2);" writes the row as
        # "a|b|2"; sqlite3 -readonly DB QUERY prints a planted database's rows.
        if [ "$1" = -readonly ]; then
            [ -f "$2" ] || {
                echo 'Error: unable to open database file' >&2
                exit 14
            }
            has control_empty && case "$2" in *tcc-control.db) exit 0 ;; esac
            cat "$2"
        else
            printf '%s\n' "$2" | sed -n "s/.*VALUES ('\([^']*\)', '\([^']*\)', \([0-9]*\)).*/\1|\2|\3/p" >"$1"
        fi
        ;;
    *)
        echo "fakecmd: no fake for $NAME" >&2
        exit 127
        ;;
esac
