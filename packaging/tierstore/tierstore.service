# tierstore (crates/tierstore): an S3 server over a hot and a cold tier of S3-compatible stores.
# New objects are written to the hot tier, copied to the cold one in the background, and freed
# from the hot one when it fills.
#
# An example, not a package: nothing installs or enables it. The binary is the release asset
# tierstore-<commit>-<platform>.tar.gz (docs/artifacts.md), placed by digest at the path of
# ExecStart= (README.md says how). The unit has no [Install] section, so placing it starts
# nothing and `systemctl enable` has nothing to link; start it with `systemctl start tierstore`
# once the files below are in place.
#
# Edit before use: the listen address (192.0.2.10 is a documentation address), the proxy id (keep
# it across restarts, and give each process over the same tiers one of its own), the buckets, the
# endpoints (http://host[:port], no path) and --hot-bytes (the bytes the hot tier is meant to hold).
#
# Files on the host, owned by the account of User=, mode 0600; the flags that name them are the
# only way the process is given a secret (it reads no environment variable):
#   /etc/tierstore/access.key        the key clients sign their requests with: the access key id on
#                                    the first line, the secret access key on the second
#   /etc/tierstore/hot.credentials   the same, for the hot tier's store
#   /etc/tierstore/cold.credentials  the same, for the cold tier's store
[Unit]
Description=tierstore, an S3 server over a hot and a cold tier
Documentation=https://github.com/komira-ai/kbf/blob/main/packaging/tierstore/README.md
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/tierstore/access.key

[Service]
Type=simple
User=tierstore
ExecStart=/usr/libexec/kbf/tierstore \
  --listen 192.0.2.10:9000 \
  --proxy-id tierstore-1 \
  --bucket tierstore \
  --access-key-file /etc/tierstore/access.key \
  --hot s3:tierstore-hot \
  --hot-endpoint http://hot-s3.farm.example:9000 \
  --hot-credentials-file /etc/tierstore/hot.credentials \
  --hot-bytes 1099511627776 \
  --cold s3:tierstore-cold \
  --cold-endpoint http://cold-s3.farm.example:9000 \
  --cold-credentials-file /etc/tierstore/cold.credentials \
  --drain-lb-wait 10s \
  --drain-deadline 15m
# On SIGTERM the process drains: /readyz says 503 and it serves for --drain-lb-wait, then refuses
# new requests and waits for those in flight for at most --drain-deadline, gives up the
# reconciler's lease (5 s at most) and exits 0. Seconds: 960 is the 10 s and the 15 m of the flags
# above and the lease, with a margin, so that systemd never sends SIGKILL to a drain in progress.
# Raise it with --drain-deadline.
KillSignal=SIGTERM
TimeoutStopSec=960
# A start that fails (a store that cannot be reached yet, an address in use) is tried again.
# Exit 2 is a command line the argument parser refused (an unknown flag, a missing or malformed
# value): a restart cannot mend it. Flag combinations and key files refused after parsing exit 1
# and are tried again every 5 s.
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=2
LimitNOFILE=65536
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
