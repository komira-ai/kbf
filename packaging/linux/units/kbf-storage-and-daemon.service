# kbf build farm storage node and node daemon in one process: `kbf --mode=storage-and-daemon`.
# Static unit: shipped by the kbf package (installed under /usr/lib/systemd/system/),
# disabled, with no rendering and no @PLACEHOLDER@ in it. It starts only once
# /etc/kbf/kbf.toml exists (ConditionPathExists=), after `kbf boot-check` (which brings the
# state database named by the `database` key of /etc/kbf/installer.toml to the schema this
# kbf declares, for the modes that keep state in it, and fails the start if it cannot) and
# `kbf --mode=<mode> --check` (which prints every missing prerequisite and exits 2). The
# checks are ExecStartPre=, not ExecCondition=: ExecCondition= skips the start silently on
# exit 1 to 254, and a unit that cannot start must fail where an operator sees it. kbf reads
# /etc/kbf/kbf.toml itself: no --config. The binary is /usr/bin/kbf, the kbf package's own
# file; only the package manager replaces it, and the schema step is that same file, so the
# kbf package needs no other package for it. Per-host values (MemoryMin=, ports,
# certificates, the cold store) are kbf.toml's, or a drop-in kbf-installer writes from it.
# kbf docs/design/architecture-v2.md, sections 1 and 11. The daemon half reads and writes
# the node's storage in-process; its control plane dials the frontend.
[Unit]
Description=kbf build farm storage node and node daemon
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/kbf/kbf.toml

# A failure that repeats quickly (the cold store or a disk not ready) must not use up
# systemd's start limit of 5 starts in 10 s and leave the unit down (package-test rule
# `restart`).
StartLimitIntervalSec=0

[Service]
# The daemon half runs its containers rootless, with crun, as the kbf user.
User=kbf
Slice=kbf.slice
# kbf's own state: /var/lib/kbf, created for the unit's user by systemd; kbf-installer never
# touches it.
StateDirectory=kbf
StateDirectoryMode=0750
# The daemon half manages its own cgroup: supervisor/ for itself, actions/ for builds.
# Delegate=yes delegates cpuset with cpu, memory and pids: --lease-placement=numa-node
# pins each lease to one NUMA node with it (package-test rule `delegate`).
Delegate=yes
OOMScoreAdjust=-925
# systemd starts a unit at a soft open-file limit of 1024; a build burst passes that (EMFILE).
LimitNOFILE=1048576
CPUWeight=300
# No MemorySwapMax=: leases may swap, and they live in this unit's cgroup.
# One unit, one process, one user: the cold store's key is not read from an
# EnvironmentFile= (package-test rule `credential`); kbf.toml names where kbf gets it. The
# user builds run as can read what this process reads, so this unit is for a trusted
# network only, as all-in-one is, until a test proves an action cannot read the key
# (design section 9).
ExecStartPre=+/usr/bin/kbf boot-check --mode=storage-and-daemon
# `--check` validates kbf.toml and what a restart cannot change (a file, a user, a flag)
# and exits 2 for those. Anything that can become ready later (a listen address, a peer,
# a DNS name, a mount) is not refused here: it exits 75 (not ready, restarted), so a check
# that runs before the bind retry never leaves the unit down for good (kbf#998, #1000).
ExecStartPre=/usr/bin/kbf --mode=storage-and-daemon --check
ExecStart=/usr/bin/kbf --mode=storage-and-daemon
# The storage half drains on SIGTERM: a Write in flight is finished and acknowledged
# before the process exits, and a large one takes longer than systemd's 90 s default stop
# timeout, which would SIGKILL it and fail the upload (package-test rule `stop`).
KillSignal=SIGTERM
TimeoutStopSec=infinity
# KillMode=mixed: systemd's default (control-group) sends SIGTERM to every process of the
# unit at once, and the actions run in sub-cgroups of it, so a stop would end them in the
# first seconds of the drain. mixed signals the main process alone; what is still left
# once it has exited, or when the stop times out, gets SIGKILL.
KillMode=mixed
Restart=on-failure
RestartSec=5
# Exit 2 is a command line kbf refused (or a config it refused): a restart cannot fix it.
# Exit 75 (a retryable failure) is restarted.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
