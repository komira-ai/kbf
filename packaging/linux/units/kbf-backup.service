# kbf state database backup: `kbf-installer backup` runs `pg_dump` (custom format) of the
# database installer.toml names into /var/lib/kbf-server/backups, keeps the newest
# `backup_keep` (default 7) and exits non-zero on any failure, so systemd marks the unit
# failed. Started by kbf-backup.timer; `systemctl start kbf-backup.service` takes one now.
# Static unit: shipped by the kbf-installer package (installed under /usr/lib/systemd/system/),
# disabled, with no rendering and no @PLACEHOLDER@ in it. `kbf-installer setup` enables the
# timer on the hosts that keep their state in Postgres (frontend, all-in-one).
#
# It runs as the frontend's service user, whose name this file does not carry: `kbf-installer
# setup` writes it into a drop-in (the service user setup resolves for the frontend, which is
# the frontend unit's User=), and the unit is gated on that drop-in, so without it the unit does not
# run (rather than run as root). The database's socket is peer-authenticated, so that user,
# through a pg_ident map or by being the role, is the role the `database` URL names; no
# password exists anywhere. The backups are that user's alone (the directory is 0700, each
# file 0600, both set by the verb, which refuses a directory owned by another user).
# StateDirectory= is the frontend's, with the same mode, so the two units agree on it.
# docs/deploy/kbf-installer-setup.md, "Backup and restore"; docs/design/frontend-proxy.md,
# section 11.
[Unit]
Description=kbf state database backup (pg_dump)
# Gated on its own configuration, which `setup` writes with the database.
ConditionPathExists=/etc/kbf/installer.toml
# The drop-in that gives the unit its User=; written by setup.
ConditionPathExists=/etc/systemd/system/kbf-backup.service.d/10-service-user.conf
# The server on this host, when it is started by systemd (the name is the Debian and the
# Fedora one); no Wants=: a database that is down fails the backup, which is what a failed
# unit is for.
After=postgresql.service

[Service]
Type=oneshot
StateDirectory=kbf-server
StateDirectoryMode=0750
UMask=0077
ExecStart=/usr/bin/kbf-installer --apply backup
# A dump of a large state must be allowed to finish; one that never does must not hold the
# timer for ever.
TimeoutStartSec=2h
# A backup must never slow the farm's builds.
Nice=10
IOSchedulingClass=idle
# Only the dump's own reach: the socket, the backup directory, nothing else.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX
