# kbf-installer proxy: the one public port of a frontend host (TLS, identity, routing) and the
# load balancer over the frontends of its pool, which run on their own (`[[proxy.frontend]]`
# tables of the [proxy] table). Static unit, installed disabled under
# /usr/lib/systemd/system/; the operator enables it with kbf-proxy.socket, which
# holds the public port (socket activation, one descriptor: LISTEN_FDS=1). Its [proxy] table
# is in /etc/kbf/installer.toml; the unit passes that file by flag and nothing by environment.
# kbf docs/design/frontend-proxy.md, sections 2, 4 and 5; kbf-proxy-api.md, section 11.
#
# Not the root helper: kbf-installer.service stages and flips releases as root, this
# service runs as the frontend's own user and starts no process but itself: it does not run,
# adopt or restart a frontend, and it needs no order against the installer. Each frontend is a
# unit of its own, which the host's operator drains through the proxy's admin API
# (`admin_listen`) and restarts. A table with the `upstream` table (two-slot supervision of
# children, which this proxy no longer does) is refused at start (exit 2).
#
# The default KillMode: a stop signals the proxy, which drains its open streams for at most 5 s
# and ends within 10 s by its own bound, and what is left of the unit's control group is killed
# after TimeoutStopSec. The frontends are other units and keep running.
[Unit]
Description=kbf frontend proxy, the load balancer over the frontends
Requires=kbf-proxy.socket
After=kbf-proxy.socket
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/kbf/installer.toml
# A crash that repeats quickly must not use up systemd's start limit (5 starts in 10 s) and
# leave the public port with no one behind it.
StartLimitIntervalSec=0

[Service]
# simple, not notify: the verb never sends READY=1, so a notify unit would never finish
# starting. The socket is already held, so a client that arrives meanwhile waits in the backlog.
Type=simple
# Not the daemon's user: it runs as kbf-server, the user of the frontends it balances over (as
# kbf-frontend.service does), so that they can read the identity secret it writes under
# /run/kbf-proxy.
User=kbf-server
Slice=kbf.slice
# The proxy-auth secret: tmpfs, so per boot, and kept across a restart of the proxy so the
# frontends, which keep running, keep accepting its identity headers.
RuntimeDirectory=kbf-proxy
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
# `--check` loads the whole file the way a run does and exits 2 on a bad table.
ExecStartPre=/usr/bin/kbf-installer proxy --config /etc/kbf/installer.toml --check
ExecStart=/usr/bin/kbf-installer proxy --config /etc/kbf/installer.toml
# `systemctl reload` is SIGHUP to the proxy: it re-reads the server certificate, key and client
# CA and swaps them in as one unit, and no open stream is cut. The command exits 0 at once; a
# rejected file shows only as one journal line from the proxy and as
# kbf_proxy_tls_reload_failed_total, with the old files still served. The renewal hook runs it
# after the last file is in place. Not a restart: that would end every stream.
ExecReload=/bin/kill -HUP $MAINPID
KillSignal=SIGTERM
TimeoutStopSec=15
# A crash restarts at once; a stop is not a crash. Exit 2 is a table the verb refused: a
# restart cannot fix it.
Restart=on-failure
RestartSec=1
RestartPreventExitStatus=2
# The front door must be the last thing the kernel kills under memory pressure, and a swap
# would slow every stream at once. The descriptors are every client connection and every
# upstream one.
OOMScoreAdjust=-900
MemorySwapMax=0
LimitNOFILE=1048576
# No new privileges, a private /tmp and no home directories.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
