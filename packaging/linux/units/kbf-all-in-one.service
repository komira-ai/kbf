# kbf build farm, all in one process: `kbf --mode=all-in-one`.
# Static unit: shipped by the kbf-installer package (installed under /usr/lib/systemd/system/),
# disabled, with no rendering and no @PLACEHOLDER@ in it. It starts only once
# /etc/kbf/kbf.toml exists (ConditionPathExists=), after kbf-installer's `boot-check` (which
# counts the starts of a release on trial and reverts a release that spends its budget) and
# `kbf --mode=<mode> --check` (which prints every missing prerequisite and exits 2). The checks
# are ExecStartPre=, not ExecCondition=: ExecCondition= skips the start silently on exit 1
# to 254, and a unit that cannot start must fail where an operator sees it. kbf reads
# /etc/kbf/kbf.toml itself: no --config. The binary is the release kbf-installer flipped
# to; only kbf-installer replaces it. Per-host values (MemoryMin=, ports, certificates,
# the cold store) are kbf.toml's, or a drop-in kbf-installer writes from it.
#
# TRUSTED, SINGLE BOX OR DEVELOPMENT ONLY. Builds run in the process that holds the
# farm's state and its cold store, as one user. The container driver runs each action
# as a subordinate id of that user (--userns=nomap), but no test yet proves an action
# cannot read what the user holds (kbf docs/design/architecture-v2.md, section 9).
[Unit]
Description=kbf build farm, all in one process
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/kbf/kbf.toml

# A failure that repeats quickly must not use up systemd's start limit of 5 starts in
# 10 s and leave the unit down.
StartLimitIntervalSec=0

[Service]
# The daemon half runs rootless Podman as the kbf user.
User=kbf
Slice=kbf.slice
# kbf's own state: /var/lib/kbf, created for the unit's user by systemd; kbf-installer never
# touches it.
StateDirectory=kbf
StateDirectoryMode=0750
# The daemon half manages its own cgroup: supervisor/ for itself, actions/ for builds.
# Delegate=yes delegates cpuset with cpu, memory and pids: --lease-placement=numa-node
# pins each lease to one NUMA node with it (check-units rule `delegate`).
Delegate=yes
OOMScoreAdjust=-925
# systemd starts a unit at a soft open-file limit of 1024; a build burst passes that (EMFILE).
LimitNOFILE=1048576
CPUWeight=300
# No MemorySwapMax=: leases may swap, and they live in this unit's cgroup.
# %U is the uid of User=: rootless Podman's runtime directory.
Environment=XDG_RUNTIME_DIR=/run/user/%U
# The single box's cold store is a directory beside the daemon's data, so the unit
# holds no cold-store key (check-units rule `credential`).
ExecStartPre=+/usr/bin/kbf-installer boot-check
ExecStartPre=/var/lib/kbf-installer/current/kbf --mode=all-in-one --check
ExecStart=/var/lib/kbf-installer/current/kbf --mode=all-in-one
# kbf drains on SIGTERM: new Execute calls are refused, open streams run until their
# action is done (Buck2 does not recover a stream that breaks), with no deadline, then
# the server exits. A stop that ends sooner fails every build in flight, so systemd sends
# SIGTERM and never kills it for taking long (check-units rule `stop`). A second SIGTERM
# ends the open streams.
KillSignal=SIGTERM
TimeoutStopSec=infinity
Restart=on-failure
RestartSec=5
# Exit 2 is a command line kbf refused (or a config it refused): a restart cannot fix it.
# Exit 75 (a retryable failure) is restarted.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
