# kbf-host-install's local socket: the root half of this host's update agent
# (docs/design/updates.md, section 4; docs/deploy/host-install.md). It binds a unix socket that
# only the account of kbf-updater-agent.service can connect to, stages a release beside the one
# that runs, switches to it on trial, and goes back to the one that ran when nobody confirms
# the new one by its deadline. The ssh forced command of the same program is not this unit and
# is unchanged.
#
# The `kbf` deb ships this unit and enables it (packaging/linux/README.md): the update is an
# installation of the attested package (--layout deb, host-install.md, "On a Linux daemon host
# that runs the package"), and the unit restarted is the daemon's. A host that runs another mode
# unit names it in a drop-in that replaces ExecStart (README.md beside this directory, "A host
# that runs the package"). The program itself is in no package: an operator places it at
# /usr/libexec/kbf/kbf-host-install (host-install.md, "Getting the binary"), where no release
# writes, and until it is there this unit is skipped, not failed.
#
# A host laid out by hand (the installer's releases under /var/lib/kbf-installer) places this
# file itself, without --layout deb, with one --restart-unit for each unit it runs from
# /var/lib/kbf-installer/releases/current. The unit is named so that it is not one of the
# transient `kbf-host-install-<version>.service` units the ssh path lists.
[Unit]
Description=kbf-host-install, the local socket of this host's update agent
Documentation=https://github.com/komira-ai/kbf/blob/main/docs/deploy/host-install.md
After=local-fs.target
ConditionFileIsExecutable=/usr/libexec/kbf/kbf-host-install

[Service]
Type=simple
# Root, on purpose: it installs packages (or moves releases under /var/lib/kbf-installer) and
# restarts units. The socket is the access control: mode 0600, owned by the one
# account named here. Root is systemd's default, so the unit names no User=: with User= set,
# even to root, and a system call filter in place (RestrictRealtime=, LockPersonality= and
# ProtectKernelModules= each add one), systemd takes CAP_SETUID from the process, and with
# NoNewPrivileges= nothing gives it back. The program then cannot drop to another account to
# run curl, and every release fetch fails (tests/real_linux_unit.rs of kbf-host-install).
ExecStart=/usr/libexec/kbf/kbf-host-install --serve --socket /run/kbf-host-install/local.sock --socket-user kbf-updater --window-secs 600 --layout deb --restart-unit kbf-daemon.service
# systemd makes /run/kbf-host-install (root's, 0755) and its state directory.
RuntimeDirectory=kbf-host-install
RuntimeDirectoryMode=0755
StateDirectory=kbf-host-install
StateDirectoryMode=0700
# A pending release is on disk, so a restart of this program, like a reboot, finds it and goes
# back at once if its deadline has passed.
Restart=always
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
