<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  kbf-host-install's local socket on a Mac: the root half of this host's update agent
  (docs/design/updates.md, section 4; docs/deploy/host-install.md). A system launchd job, as
  root. It binds a socket only the account _kbf-updater can connect to (mode 0600), stages the
  release beside the one that runs in the installer layout (/usr/local/kbf-installer, laid out
  by the kbf-installer package and kbf-mac-provision), counts the Mac's leases before it
  switches, switches to it on trial by kickstarting the daemon's job named by --launchd-label,
  and goes back to the one that ran when nobody confirms the new one by its deadline. On a Mac
  the older kit laid out (/usr/local/kbf), leave out the two --launchd-label lines.
  The ssh forced command (and its sudo rule) is not this job and is unchanged.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.komira.kbf-host-install-local</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/kbf/kbf-host-install</string>
		<string>--serve</string>
		<string>--socket</string>
		<string>/var/db/kbf-host-install/local.sock</string>
		<string>--socket-user</string>
		<string>_kbf-updater</string>
		<string>--window-secs</string>
		<string>600</string>
		<string>--launchd-label</string>
		<string>com.komira.kbf-daemon</string>
	</array>
	<key>UserName</key>
	<string>root</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>5</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/kbf-host-install/local.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/kbf-host-install/local.err.log</string>
</dict>
</plist>
