<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  kbf-updater in its agent mode on a Mac (docs/design/updates.md): an unprivileged updater that
  heartbeats to the coordinator over mutual TLS and runs this host's update through the local
  socket of com.komira.kbf-host-install-local. It listens on nothing. The certificate, key and CA
  are files an operator placed (enrollment is a later step); the key is owned by _kbf-updater with
  mode 0600. Edit the values to the farm's.

  This job gives the agent NO credential for the frontend's operator API: the drain of the node
  and its health need the full operator token (no scoped credential exists yet; docs/api.md plans
  the roles), and the design keeps that token off hosts. So the agent heartbeats and refuses
  every update order, before it fetches anything. An operator who accepts the token on a host
  adds --operator-api and --token-file (and their values) to ProgramArguments, knowing that
  anything running as _kbf-updater can then read it.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.komira.kbf-updater-agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/libexec/kbf/kbf-updater</string>
		<string>agent</string>
		<string>--coordinator</string>
		<string>coordinator.farm.example:8443</string>
		<string>--client-cert</string>
		<string>/usr/local/etc/kbf/updater/cert.pem</string>
		<string>--client-key</string>
		<string>/usr/local/etc/kbf/updater/key.pem</string>
		<string>--ca</string>
		<string>/usr/local/etc/kbf/updater/ca.pem</string>
		<string>--channel</string>
		<string>stable</string>
		<string>--helper-socket</string>
		<string>/var/db/kbf-host-install/local.sock</string>
	</array>
	<key>UserName</key>
	<string>_kbf-updater</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Library/Logs/kbf-updater/agent.log</string>
	<key>StandardErrorPath</key>
	<string>/Library/Logs/kbf-updater/agent.err.log</string>
</dict>
</plist>
