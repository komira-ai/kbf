load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared: its tests read the
# vendored protos of proto/ and their PINS.
cargo_package(
    path = ".",
    extra_srcs = [
        "proto",
    ],
)
