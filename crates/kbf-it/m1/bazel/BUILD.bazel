# Three actions in a chain. `shout` runs an executable input file, `tools/kbf-act`
# (`kbf-act upper`; `kbf-cell m1` copies it into its copy of this project), so the farm
# must keep its mode; `digest` reads two outputs of earlier actions.

genrule(
    name = "words",
    srcs = ["data/words.txt"],
    outs = ["words.sorted"],
    cmd = "sort $< > $@",
)

genrule(
    name = "shout",
    srcs = [":words"],
    outs = ["words.upper"],
    cmd = "$(location tools/kbf-act) upper $@ $(location :words)",
    tools = ["tools/kbf-act"],
)

genrule(
    name = "digest",
    srcs = [
        ":shout",
        ":words",
    ],
    outs = ["digest.txt"],
    cmd = "cat $(location :words) $(location :shout) | sha256sum > $@",
)
