# A Mac installed by the Mac kit, as the kit leaves it: kind, mode, owner:group, host path
# [, link target | @fixture file]. Owners are recorded, not applied (a test does not run as root).
# Sources are in README.md. There is no /var/db/kbf-deploy and no state.json: the links are the truth.
dir  0755 root:wheel /usr/local/kbf
dir  0755 root:wheel /usr/local/kbf/releases
dir  0755 root:wheel /usr/local/kbf/releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
file 0755 root:wheel /usr/local/kbf/releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa/kbf
dir  0755 root:wheel /usr/local/kbf/releases/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
file 0755 root:wheel /usr/local/kbf/releases/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb/kbf
link -    root:wheel /usr/local/kbf/current  releases/bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
link -    root:wheel /usr/local/kbf/previous releases/aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
dir  0755 root:wheel /usr/local/kbf/etc
file 0644 root:wheel /usr/local/kbf/etc/ca.pem
dir  0750 root:_kbf  /usr/local/kbf/etc/v2
file 0644 root:_kbf  /usr/local/kbf/etc/v2/daemon-mac-a.pem
file 0400 _kbf:_kbf  /usr/local/kbf/etc/v2/daemon-mac-a.key
file 0644 root:wheel /usr/local/kbf/etc/av2_mac.conf @av2_mac.conf
dir  0750 _kbf:_kbf  /usr/local/kbf/log
dir  0700 _kbf:_kbf  /usr/local/kbf/work
dir  0700 _kbf:_kbf  /usr/local/kbf/work/daemon
dir  0700 _kbf:_kbf  /usr/local/kbf/work/daemon/data
dir  0755 root:wheel /usr/local/kbf/removed
dir  0755 root:wheel /usr/local/etc/kbf
file 0644 root:wheel /usr/local/etc/kbf/kbf.toml @kbf.toml
dir  0755 root:wheel /Library/LaunchDaemons
file 0644 root:wheel /Library/LaunchDaemons/com.komira.kbf-daemon.plist @launchd_new.plist
