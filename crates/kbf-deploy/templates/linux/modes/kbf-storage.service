# Rendered by `kbf-deploy linux render-units --mode storage`; installed as
# /etc/systemd/system/kbf-storage.service (kbf docs/design/architecture-v2.md,
# sections 1 and 11). `check-units --mode storage` parses the flags below with
# `kbf check-args storage`.
[Unit]
Description=kbf build farm storage node
Wants=network-online.target
After=network-online.target @MINIO_UNIT@

[Service]
# Not the daemon's user: a storage node holds the cold store's key.
User=@KBF_SERVER_USER@
Slice=kbf.slice
# kbf-server's peak use today (KBF_SERVER_RESERVATION_GIB).
MemoryMin=@SERVER_MEMORY_MIN@
# A storage node answering from swap would slow every build at once.
MemorySwapMax=0
OOMScoreAdjust=-925
CPUWeight=300
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY of the bucket's MinIO service account,
# mode 0600: a secret never goes on the command line.
EnvironmentFile=@KBF_ETC@/s3.env
ExecStart=@KBF_BIN_DIR@/kbf storage \
    --storage-tls-cert=@KBF_ETC@/storage.pem \
    --storage-tls-key=@KBF_ETC@/storage.key \
    --storage-client-ca=@KBF_ETC@/ca.pem
# The three certificate flags come together and turn on mutual TLS with the check of the
# role in each caller's certificate; without them the node serves plain text on
# loopback only and refuses to start on any other address. Paths, never the PEM itself
# and never an environment variable. The key is readable by the server user only.
# TODO: the rest of the node's flags (--cold-store, --meta-dir, --hot-store and
# --storage-listen, which needs a port setting; --frontend and --advertise-addr come
# with the map).
Restart=on-failure
# Exit 2 is a command line kbf refused (or a mode not built yet): a restart cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
