# Rendered by `kbf-deploy linux render-units --mode storage-and-daemon`; installed as
# /etc/systemd/system/kbf-storage-and-daemon.service (kbf
# docs/design/architecture-v2.md, sections 1 and 11). The daemon half reads and writes
# the node's storage in-process; its control plane dials --server.
[Unit]
Description=kbf build farm storage node and node daemon
Wants=network-online.target
After=network-online.target @MINIO_UNIT@

[Service]
User=@KBF_USER@
Slice=kbf.slice
# The daemon half manages its own cgroup: supervisor/ for itself, actions/ for builds.
# Delegate=yes delegates cpuset with cpu, memory and pids: --lease-placement=numa-node
# pins each lease to one NUMA node with it (check-units rule `delegate`).
Delegate=yes
# kbf-server's and the daemon's reservations today.
MemoryMin=@SERVER_MEMORY_MIN@
OOMScoreAdjust=-925
CPUWeight=300
# No MemorySwapMax=: leases may swap, and they live in this unit's cgroup.
Environment=XDG_RUNTIME_DIR=/run/user/@KBF_UID@
# TODO: the cold store's key, readable by the storage half's uid and not by the
# actions' (design section 9); no EnvironmentFile= until that split exists.
ExecStart=@KBF_BIN_DIR@/kbf storage-and-daemon \
    --storage-tls-cert=@KBF_ETC@/storage.pem \
    --storage-tls-key=@KBF_ETC@/storage.key \
    --storage-client-ca=@KBF_ETC@/ca.pem \
    --driver=container \
    --server=https://@KBF_HOST_NAME@:@KBF_WORKER_PORT@ \
    --ca-cert=@KBF_ETC@/ca.pem \
    --cert=@KBF_ETC@/node.pem \
    --key=@KBF_ETC@/node.key \
    --node-id=@KBF_NODE_ID@ \
    --data-dir=@KBF_DATA_DIR@ \
@DAEMON_IMAGE_ARGS@
    --actions-memory-max-gib=@ACTIONS_MEMORY_MAX_GIB@ \
    --supervisor-memory-min-mib=@KBF_DAEMON_MEMORY_MIN_MIB@
# The storage half's flags are the storage unit's (its three certificate flags; no
# --cas: the daemon half reads the node's storage in-process), then the daemon unit's.
# TODO: the rest of the storage half's flags, as the storage unit gets them
# (--cold-store, --meta-dir, --hot-store on --data-dir's filesystem for the one cache,
# --storage-listen), and --frontend and --advertise-addr with the map.
Restart=on-failure
# Exit 2 is a command line kbf refused (or a mode not built yet): a restart cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
