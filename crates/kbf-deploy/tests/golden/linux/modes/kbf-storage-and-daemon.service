# Rendered by `kbf-deploy linux render-units --mode storage-and-daemon`; installed as
# /etc/systemd/system/kbf-storage-and-daemon.service (kbf
# docs/design/architecture-v2.md, sections 1 and 11). The daemon half reads and writes
# the node's storage in-process; its control plane dials --server.
[Unit]
Description=kbf build farm storage node and node daemon
Wants=network-online.target
After=network-online.target minio.service

[Service]
User=kbf
Slice=kbf.slice
# The daemon half manages its own cgroup: supervisor/ for itself, actions/ for builds.
# Delegate=yes delegates cpuset with cpu, memory and pids: --lease-placement=numa-node
# pins each lease to one NUMA node with it (check-units rule `delegate`).
Delegate=yes
# kbf-server's and the daemon's reservations today.
MemoryMin=16G
OOMScoreAdjust=-925
CPUWeight=300
# No MemorySwapMax=: leases may swap, and they live in this unit's cgroup.
Environment=XDG_RUNTIME_DIR=/run/user/1500
# One unit, one process: the daemon half reads and writes the node's storage in-process,
# one cache on the SSD (design sections 1 and 10). The design keeps the cold store's key
# from builds by uid (sections 9 and 15): the key file the unit's user's alone, mode
# 0600, and each action a subordinate id of that user (the container driver's
# --userns=nomap), with a test that an action cannot read the key. The daemon half runs
# as the unit's user and so could read it.
# TODO: the cold store's key (EnvironmentFile=/etc/kbf/s3.env), once that test exists;
# until then the unit holds none (check-units rule `credential`), and with the key it is
# for a trusted network only, as all-in-one is.
ExecStart=/usr/local/bin/kbf storage-and-daemon \
    --storage-tls-cert=/etc/kbf/storage.pem \
    --storage-tls-key=/etc/kbf/storage.key \
    --storage-client-ca=/etc/kbf/ca.pem \
    --driver=container \
    --server=https://storage-node.example.internal:8981 \
    --ca-cert=/etc/kbf/ca.pem \
    --cert=/etc/kbf/node.pem \
    --key=/etc/kbf/node.key \
    --node-id=storage-node-1 \
    --data-dir=/var/lib/kbf \
    --actions-memory-max-gib=200 \
    --supervisor-memory-min-mib=256
# The storage half's flags are the storage unit's (its three certificate flags; no
# --cas: the daemon half reads the node's storage in-process), then the daemon unit's.
# TODO: the rest of the storage half's flags, as the storage unit gets them
# (--cold-store, --meta-dir, --hot-store on --data-dir's filesystem for the one cache,
# --storage-listen).
# TODO(registration): --frontend=<the frontend's DNS name> and --advertise-addr, and the
# storage map the frontend pushes.
# The storage half drains on SIGTERM: a Write in flight is finished and acknowledged
# before the process exits, and a large one takes longer than systemd's 90 s default stop
# timeout, which would SIGKILL it and fail the upload (check-units rule `stop`).
KillSignal=SIGTERM
TimeoutStopSec=infinity
Restart=on-failure
# Exit 2 is a command line kbf refused (or a mode not built yet): a restart cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
