# Rendered by `kbf-deploy linux render-units --mode frontend`; installed as
# /etc/systemd/system/kbf-frontend.service (kbf docs/design/architecture-v2.md,
# sections 1 and 11). `kbf frontend` is not built yet: it exits
# 2 at start, and `check-units --mode frontend` refuses any flag on its command line
# until kbf takes some.
[Unit]
Description=kbf build farm frontend
Wants=network-online.target
After=network-online.target

[Service]
# Not the daemon's user: the frontend holds the state store and the operator token.
User=kbf-server
Slice=kbf.slice
# A frontend answering from swap would slow every build at once.
MemorySwapMax=0
OOMScoreAdjust=-925
CPUWeight=300
ExecStart=/usr/local/bin/kbf frontend
# TODO: the frontend's flags (its listen addresses, the state store,
# the certificate flags), once `kbf frontend` has them.
# SIGTERM drains: new Execute calls are refused, open streams run until their action is
# done (Buck2 does not recover a stream that breaks), then the server exits. systemd must
# not SIGKILL it meanwhile, so no stop timeout. A second SIGTERM ends the open streams
# (`systemctl kill --signal=TERM` on the unit), and `kbf cluster drain --frontend` begins the
# same drain with no signal.
TimeoutStopSec=infinity
Restart=on-failure
# Exit 2 is a command line kbf refused (or a mode not built yet): a restart cannot fix it.
RestartPreventExitStatus=2

[Install]
WantedBy=multi-user.target
