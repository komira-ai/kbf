        },
        "name": "kbf-envoy",
        "namespace": "kbf-front"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/name": "kbf-envoy"
          }
        },
        "strategy": {
          "rollingUpdate": {
            "maxSurge": 1,
            "maxUnavailable": 0
          },
          "type": "RollingUpdate"
        },
        "template": {
          "metadata": {
            "annotations": {
              "kbf-front/envoy-config-sha256": "032d2026ab5c56017e1d6bf6d1d6c772265299fd8eb8b2b810f9cc8b6ee680eb"
            },
            "labels": {
              "app.kubernetes.io/name": "kbf-envoy",
              "app.kubernetes.io/part-of": "kbf-front"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "containers": [
              {
                "args": [
                  "--config-path",
                  "/etc/envoy/envoy.json",
                  "--log-level",
                  "info"
                ],
                "image": "envoyproxy/envoy:distroless-v1.39.3@sha256:7369b033550a14997e5d698677b7b51f0210a80754f5d084c5caa1a78268267b",
                "livenessProbe": {
                  "failureThreshold": 6,
                  "periodSeconds": 10,
                  "tcpSocket": {
                    "port": 8080
                  }
