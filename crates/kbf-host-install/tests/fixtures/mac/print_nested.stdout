system/com.example.kbf-real-mac-test.nested.3110 = {
	active count = 0
	path = /private/var/tmp/kbf-real-mac-nested-3110-5/job.plist
	type = LaunchDaemon
	state = not running

	program = /bin/sleep
	arguments = {
		/bin/sleep
		600
	}

	default environment = {
		PATH => /usr/bin:/bin:/usr/sbin:/sbin
	}

	environment = {
		XPC_SERVICE_NAME => com.example.kbf-real-mac-test.nested.3110
	}

	domain = system
	minimum runtime = 10
	exit timeout = 5
	runs = 0
	last exit code = (never exited)

	event triggers = {
		com.apple.launchd.WatchPaths => {
			keepalive = 0
			service = com.example.kbf-real-mac-test.nested.3110
			stream = com.apple.fsevents.matching
			monitor = com.apple.UserEventAgent-System
			descriptor = {
				"WatchPaths" => [
					0 = "/private/var/tmp/kbf-real-mac-watched"
				]
			}
		}
	}

	endpoints = {
		"com.example.kbf-real-mac-test.service" = {
			port = 0x0
			active = 0
			managed = 1
			reset = 0
			hide = 0
			watching = 1
		}
	}

	event channels = {
		"com.apple.fsevents.matching" = {
			port = 0x0
			active = 0
			managed = 1
			reset = 0
			hide = 0
			watching = 1
		}
	}

	spawn type = daemon (3)
	jetsam priority = 40
	jetsam memory limit (active) = (unlimited)
	jetsam memory limit (inactive) = (unlimited)
	jetsamproperties category = daemon
	jetsam thread limit = 32
	cpumon = default
	run interval = 86400 seconds
	probabilistic guard malloc policy = {
		activation rate = 1/1000
		sample rate = 1/0
	}

	properties = inferred program | system service | tle system
}
