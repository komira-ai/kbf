# js-mdm-depserver.service: NanoDEP's depserver (the Apple Business Manager
# token, the ADE profile, Apple's device API behind /proxy/), rendered by
# `js-mdm install`. Loopback only and never proxied. The API key
# comes from EnvironmentFile as NANODEP_API, never argv.
[Unit]
Description=js-mdm NanoDEP depserver (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=js-mdm
Group=js-mdm
Slice=js-mdm.slice
EnvironmentFile=/etc/js-mdm/nanodep.env
ExecStart=/opt/js-mdm/bin/depserver -listen 127.0.0.1:9001 -storage filekv -storage-dsn /var/lib/js-mdm/dep
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ReadWritePaths=/var/lib/js-mdm/dep
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
