# kbf-mdm-cert.timer: run kbf-mdm-cert.service twice a day (a run missed while the
# host was down runs at boot). Rendered by `kbf-deploy mdm tls`.
[Unit]
Description=kbf-mdm TLS certificate renewal, twice a day

[Timer]
OnCalendar=*-*-* 04,16:23:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
