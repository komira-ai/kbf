# @PREFIX@-proxy-reload.path: when lego writes a new certificate, restart the proxy
# so it serves it (Caddy runs with its admin API off, so a restart is how it
# reloads). Rendered by `js-mdm tls`.
[Unit]
Description=@PREFIX@: restart the proxy when the certificate changes

[Path]
PathChanged=@STATE@/lego/certificates/@DNS_NAME@.crt
Unit=@PREFIX@-proxy-reload.service

[Install]
WantedBy=multi-user.target
