# @PREFIX@-cert.timer: run @PREFIX@-cert.service twice a day (a run missed while the
# host was down runs at boot). Rendered by `js-mdm tls`.
[Unit]
Description=@PREFIX@ TLS certificate renewal, twice a day

[Timer]
OnCalendar=*-*-* 04,16:23:00
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target
