load("//:buildrules.bzl", "cargo_package")

# What this package reads beyond what buildrules gives each of its units (a library src/ and
# build.rs, a test target tests/), which a Buck2 action sees only when declared: its library
# includes config.example, pins.txt and the files of templates/.
cargo_package(
    path = ".",
    extra_srcs = [
        "config.example",
        "pins.txt",
        "templates",
    ],
)

# Read by other members (their extra_srcs); exported by reference, so each stays at its path.
export_file(
    name = "config.example",
    src = "config.example",
    mode = "reference",
    visibility = ["PUBLIC"],
)
